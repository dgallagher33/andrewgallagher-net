---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
---

<Layout title="Welcome to Astro">
  <main class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100">
    <div class="container mx-auto px-4 py-12">
      <h1 class="text-5xl font-bold text-gray-900 mb-4">Welcome to Astro</h1>
      <p class="text-xl text-gray-700 mb-8">
        A modern framework for building fast, content-focused websites with less JavaScript.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <Card
          title="Fast by Default"
          description="Astro ships zero JavaScript by default. Load the page faster."
        />
        <Card
          title="Tailwind CSS"
          description="Utility-first CSS framework for rapid UI development."
        />
        <Card
          title="TypeScript Ready"
          description="Full TypeScript support for type-safe development."
        />
      </div>
    </div>
  </main>
</Layout>
