---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import SkillBadge from '../components/SkillBadge.astro';
import TimelineItem from '../components/TimelineItem.astro';
import resume from '../data/resume.json';

import '../styles/tailwind.css';

const { name, title, location, summary, contact, skills, experience, projects, education } = resume;

const contactLinks = [
  { label: contact.email, href: `mailto:${contact.email}`, aria: 'Email' },
  { label: contact.phone, href: `tel:${contact.phone.replace(/[^+\d]/g, '')}`, aria: 'Phone' },
  { label: contact.website, href: contact.website, aria: 'Website' },
  { label: 'LinkedIn', href: contact.linkedin, aria: 'LinkedIn' },
  ...(contact.github ? [{ label: 'GitHub', href: contact.github, aria: 'GitHub' }] : []),
];
---
<BaseLayout title={`${name} — ${title}`} description={`Resume for ${name}`}>
  <div class="flex flex-col gap-6 sm:gap-8">
    <header class="glass-panel relative overflow-hidden p-6 sm:p-8">
      <div class="absolute inset-0 -z-10 bg-gradient-to-tr from-sky-100/70 via-white to-indigo-50"></div>
      <div class="absolute left-8 top-8 -z-0 h-24 w-24 rounded-full bg-sky-200/40 blur-3xl"></div>
      <div class="absolute right-6 bottom-8 -z-0 h-32 w-32 rounded-full bg-indigo-200/30 blur-3xl"></div>
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Open to opportunities</p>
          <h1 class="mt-2 text-3xl font-bold sm:text-4xl lg:text-5xl">{name}</h1>
          <p class="mt-2 text-lg font-semibold text-slate-700 sm:text-xl">{title}</p>
          <p class="text-sm text-slate-500">{location}</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href="/resume.json" class="soft-button primary">
            <span>Download JSON</span>
          </a>
          <a href={contact.website} class="soft-button secondary">
            <span>Portfolio</span>
          </a>
        </div>
      </div>
      <p class="mt-5 max-w-3xl text-base leading-relaxed text-slate-700 sm:text-lg">{summary}</p>
      <div class="mt-6 flex flex-wrap gap-3">
        {contactLinks.map((link) => (
          <a href={link.href} aria-label={link.aria} set:key={link.href} class="pill">
            <span>{link.label}</span>
          </a>
        ))}
      </div>
    </header>

    <Section title="Skills" subtitle="Technologies and strengths" icon="🛠️">
      <div class="grid gap-4 sm:grid-cols-2">
        {skills.map((group) => (
          <div
            class="rounded-2xl border border-slate-100 bg-slate-50/60 p-4"
            set:key={group.category}
          >
            <p class="text-sm font-semibold text-slate-700">{group.category}</p>
            <div class="mt-3 flex flex-wrap gap-2">
              {group.items.map((skill) => (
                <SkillBadge label={skill} set:key={skill} />
              ))}
            </div>
          </div>
        ))}
      </div>
    </Section>

    <Section title="Experience" subtitle="Roles and accomplishments" icon="💼">
      <ol class="space-y-5">
        {experience.map((item) => (
          <TimelineItem
            title={`${item.role} · ${item.company}`}
            subtitle={item.summary}
            period={`${item.start} — ${item.end}`}
            location={item.location}
            bullets={item.achievements}
            set:key={`${item.company}-${item.start}`}
          />
        ))}
      </ol>
    </Section>

    {projects?.length > 0 && (
      <Section title="Projects" subtitle="Selected work" icon="🚀">
        <div class="grid gap-4 md:grid-cols-2">
          {projects.map((project) => (
            <article
              class="flex h-full flex-col gap-3 rounded-2xl border border-slate-200 bg-white/80 p-5 shadow-sm"
              set:key={project.name}
            >
              <div class="flex items-start justify-between gap-3">
                <div>
                  <h3 class="text-lg font-semibold text-slate-900">{project.name}</h3>
                  <p class="text-sm text-slate-600">{project.summary}</p>
                </div>
                {project.link && (
                  <a
                    href={project.link}
                    class="rounded-full border border-slate-200 px-3 py-1 text-xs font-semibold text-slate-700 hover:border-sky-200 hover:bg-sky-50"
                  >
                    Visit
                  </a>
                )}
              </div>
              {project.technologies?.length > 0 && (
                <div class="flex flex-wrap gap-2">
                  {project.technologies.map((tech) => (
                    <SkillBadge label={tech} set:key={tech} />
                  ))}
                </div>
              )}
              {project.highlights?.length > 0 && (
                <ul class="mt-1 space-y-2 text-sm text-slate-700">
                  {project.highlights.map((highlight, index) => (
                    <li class="flex gap-2" set:key={`${project.name}-${index}`}>
                      <span class="mt-1 inline-block h-2 w-2 rounded-full bg-slate-300"></span>
                      <span>{highlight}</span>
                    </li>
                  ))}
                </ul>
              )}
            </article>
          ))}
        </div>
      </Section>
    )}

    {education?.length > 0 && (
      <Section title="Education" subtitle="Academic background" icon="🎓">
        <ol class="space-y-4">
          {education.map((item) => (
            <TimelineItem
              title={item.school}
              subtitle={item.degree}
              period={`${item.start} — ${item.end}`}
              location={item.location}
              details={item.details}
              set:key={`${item.school}-${item.start}`}
            />
          ))}
        </ol>
      </Section>
    )}
  </div>
</BaseLayout>
