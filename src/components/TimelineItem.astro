---
interface Props {
  title: string;
  subtitle?: string;
  period?: string;
  location?: string;
  details?: string;
  bullets?: string[];
}

const { title, subtitle, period, location, details, bullets = [] } = Astro.props;
---
<li class="relative flex gap-4">
  <span class="mt-2 h-3 w-3 rounded-full bg-sky-500 ring-4 ring-white"></span>
  <div class="flex-1 rounded-2xl border border-slate-200/80 bg-white/80 p-4 shadow-sm shadow-slate-100">
    <div class="flex flex-wrap items-baseline justify-between gap-2">
      <div>
        <h3 class="text-base font-semibold text-slate-900 sm:text-lg">{title}</h3>
        {subtitle && <p class="text-sm text-slate-600">{subtitle}</p>}
      </div>
      {(period || location) && (
        <p class="text-xs font-medium uppercase tracking-wide text-slate-500">
          {[period, location].filter(Boolean).join(' • ')}
        </p>
      )}
    </div>
    {details && <p class="mt-2 text-sm text-slate-600">{details}</p>}
    {bullets.length > 0 && (
      <ul class="mt-3 space-y-2 text-sm text-slate-700">
        {bullets.map((bullet, index) => (
          <li class="flex gap-2" set:key={`${title}-${index}`}>
            <span class="mt-1 inline-block h-2 w-2 rounded-full bg-slate-300" aria-hidden="true"></span>
            <span>{bullet}</span>
          </li>
        ))}
      </ul>
    )}
  </div>
</li>
