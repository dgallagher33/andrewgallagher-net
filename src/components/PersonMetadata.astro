---
import {linkedinUrl} from '../data/resume';
const identity = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Andrew Gallagher',
  jobTitle: 'Digital Product Manager',
  worksFor: { '@type': 'Organization', name: 'McNeil & Company' },
  sameAs: ['https://github.com/dgallagher33', linkedinUrl],
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'University at Buffalo' },
    { '@type': 'CollegeOrUniversity', name: 'Tompkins Cortland Community College' }
  ],
  description: 'Product management, insurance workflow modernization, technical systems, data integration and applied AI.'
