---
const { title = 'Resume', description = 'Personal resume built with Astro and Tailwind CSS' } = Astro.props;
---
<!DOCTYPE html>
<html lang="en" class="bg-slate-50 text-slate-900">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-slate-50 font-body antialiased">
    <div class="absolute inset-0 -z-10" style={{ backgroundImage: 'var(--bg-gradient)' }}></div>
    <div class="mx-auto flex min-h-screen max-w-6xl flex-col px-4 pb-12 pt-8 sm:px-8">
      <main class="flex-1">
        <slot />
      </main>
      <footer class="mt-16 flex flex-col gap-3 rounded-2xl border border-white/50 bg-white/70 px-6 py-5 text-sm text-slate-600 shadow-inner shadow-slate-200/60 backdrop-blur">
        <p class="font-semibold text-slate-800">Built with Astro + Tailwind CSS.</p>
        <p>Content is driven from a structured JSON file so you can keep data and presentation in sync.</p>
      </footer>
    </div>
  </body>
</html>
